{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["vendorId","vendorNodeCode","nodeType","regionId","timezone","postalCode","countryCode"],"properties":{"vendorId":{"type":"string"},"vendorNodeCode":{"type":"string","maxLength":100,"description":"The vendor's own code for the node, unique per vendor."},"nodeType":{"type":"string","description":"Node types a vendor may register. Parcel nodes are network-operated.","enum":["FULFILLMENT_CENTER","INBOUND_CROSS_DOCK","RETURNS_CENTER"],"title":"NodeType"},"subtype":{"type":"string","enum":["SORTABLE","NON_SORTABLE","XL","SOFT_LINES","SUB_SAME_DAY","FRESH","MICRO"],"title":"NodeSubtype"},"regionId":{"type":"string"},"timezone":{"type":"string","example":"America/Sao_Paulo"},"postalCode":{"type":"string","maxLength":100,"description":"The node's own location (a building), not a customer address."},"countryCode":{"type":"string","pattern":"^[A-Z]{2}$","description":"ISO 3166-1 alpha-2."},"lat":{"type":"number","minimum":-90,"maximum":90},"lon":{"type":"number","minimum":-180,"maximum":180}},"title":"NodeRegistrationRequest"}}}}}